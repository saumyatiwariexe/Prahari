          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1_dec" value="DECISION ENGINE — backend/decision/engine.py" style="swimlane;fontStyle=1;align=left;startSize=28;fillColor=#f8f8f8;strokeColor=#333;fontColor=#333;fontSize=11;" vertex="1" parent="d1_1">
          <mxGeometry x="234" y="560" width="700" height="215" as="geometry" />
        </mxCell>
        <mxCell id="d1_l1" value="&lt;b&gt;LEVEL 1 — AUTO&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Fires in &lt;b&gt;&lt;3 seconds&lt;/b&gt;&lt;br/&gt;No human input&lt;br/&gt;&lt;br/&gt;• PA Announcement&lt;br/&gt;• Signage update&lt;br/&gt;• Escalator direction flip&lt;br/&gt;&lt;br/&gt;TRIGGER: density ≥ 5/m²" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="d1_dec">
          <mxGeometry x="20" y="38" width="200" height="162" as="geometry" />
        </mxCell>
        <mxCell id="d1_l2" value="&lt;b&gt;LEVEL 2 — STAGED&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;10-second cancel window&lt;/b&gt;&lt;br/&gt;Human can cancel&lt;br/&gt;&lt;br/&gt;• Gate reduction 50%&lt;br/&gt;• RPF deploy request&lt;br/&gt;• Auto-executes at t=10s&lt;br/&gt;&lt;br/&gt;TRIGGER: density ≥ 6/m²" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="d1_dec">
          <mxGeometry x="250" y="38" width="200" height="162" as="geometry" />
        </mxCell>
        <mxCell id="d1_l3" value="&lt;b&gt;LEVEL 3 — CONFIRM&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;&lt;b&gt;NEVER auto-fires&lt;/b&gt;&lt;br/&gt;Explicit tap required&lt;br/&gt;&lt;br/&gt;• Platform full closure&lt;br/&gt;• Pre-filled decision card&lt;br/&gt;• One-tap confirm only&lt;br/&gt;&lt;br/&gt;TRIGGER: predicted crush &lt;60s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;verticalAlign=top;" vertex="1" parent="d1_dec">
          <mxGeometry x="480" y="38" width="200" height="162" as="geometry" />
        </mxCell>
        <mxCell id="d1_e4" value="interventions + zone data" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;fontStyle=2;" edge="1" source="d1_dec" target="d1_api" parent="d1_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="d1_api" value="&lt;b&gt;FastAPI Backend — main.py&lt;/b&gt;&lt;br/&gt;WebSocket /ws/live → push every 100ms  |  POST /demo/start  |  POST /intervention/{id}/confirm  |  POST /intervention/{id}/cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="d1_1">
