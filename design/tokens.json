{
  "brand": {
    "name": "Prahari",
    "tagline": "Predict. Respond. Prevent.",
    "context": "FAR AWAY 2026 · Railways Theme · Crowd Safety AI"
  },

  "color": {
    "background": {
      "base":    "#080C14",
      "surface": "#0C1220",
      "card":    "#0F1828"
    },
    "border": {
      "subtle":  "#0E1E30",
      "default": "#142035",
      "accent":  "#1A3050"
    },
    "text": {
      "primary":   "#C8D8E8",
      "secondary": "#8AB4D4",
      "dim":       "#4A6A84",
      "ghost":     "#1A3050"
    },
    "level": {
      "l1":      "#00C84C",
      "l2":      "#E8A000",
      "l3":      "#E82020",
      "prewarn": "#FF6B00",
      "sos":     "#FF1A1A"
    },
    "semantic": {
      "safe":    "#00C84C",
      "warning": "#E8A000",
      "danger":  "#E82020",
      "critical": "#FF1A1A"
    },
    "white": "#FFFFFF",
    "black": "#000000"
  },

  "typography": {
    "fonts": {
      "display": "Space Grotesk",
      "body":    "Inter",
      "mono":    "Space Mono"
    },
    "google_import": "@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=Space+Mono:wght@400;700&display=swap');",
    "scale": {
      "hero":    { "size": 72, "weight": 700, "tracking": "-0.02em", "font": "Space Grotesk" },
      "h1":      { "size": 48, "weight": 600, "tracking": "-0.01em", "font": "Space Grotesk" },
      "h2":      { "size": 32, "weight": 600, "tracking": "-0.01em", "font": "Space Grotesk" },
      "h3":      { "size": 20, "weight": 500, "tracking": "0",       "font": "Space Grotesk" },
      "body":    { "size": 16, "weight": 400, "tracking": "0",       "font": "Inter"         },
      "small":   { "size": 13, "weight": 400, "tracking": "0.01em",  "font": "Inter"         },
      "label":   { "size": 11, "weight": 500, "tracking": "0.12em",  "font": "Space Grotesk", "transform": "uppercase" },
      "data":    { "size": 13, "weight": 400, "tracking": "0.04em",  "font": "Space Mono"    },
      "stat":    { "size": 56, "weight": 700, "tracking": "-0.02em", "font": "Space Grotesk" }
    }
  },

  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 40,
    "2xl": 64,
    "3xl": 96
  },

  "radius": {
    "none": 0,
    "sm": 2,
    "md": 4,
    "lg": 8
  },

  "motion": {
    "durations": {
      "instant":  80,
      "fast":     150,
      "default":  300,
      "slow":     600,
      "verySlow": 1200
    },
    "easing": {
      "sharp":   "cubic-bezier(0.4, 0, 0.6, 1)",
      "smooth":  "cubic-bezier(0.25, 0.46, 0.45, 0.94)",
      "bounce":  "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "linear":  "linear"
    },
    "signature": {
      "fade_up":    { "from": { "opacity": 0, "y": 16 }, "to": { "opacity": 1, "y": 0 }, "duration": 400, "easing": "smooth" },
      "fade_in":    { "from": { "opacity": 0 },          "to": { "opacity": 1 },          "duration": 300, "easing": "smooth" },
      "slide_left": { "from": { "opacity": 0, "x": 24 }, "to": { "opacity": 1, "x": 0 }, "duration": 350, "easing": "smooth" },
      "scale_in":   { "from": { "opacity": 0, "scale": 0.92 }, "to": { "opacity": 1, "scale": 1 }, "duration": 300, "easing": "bounce" }
    },
    "stagger": 80
  },

  "layout": {
    "canvas": { "width": 1920, "height": 1080 },
    "safe_area": { "top": 80, "right": 96, "bottom": 80, "left": 96 },
    "grid": { "columns": 12, "gutter": 24 }
  }
}
